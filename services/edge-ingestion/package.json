{
  "name": "@eco-sense/edge-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build:edge": "esbuild src/edgeEntry.ts --bundle --platform=neutral --format=esm --outfile=../../infra/supabase/functions/edge-ingest/bundle.mjs",
    "test": "node --loader ts-node/esm --test tests/contract.test.ts",
    "test:all": "node --loader ts-node/esm --test tests/**/*.test.ts",
    "test:integration": "node --loader ts-node/esm --test tests/integration.test.ts",
    "mock:ingest": "node --loader ts-node/esm scripts/mock_ingest.ts",
    "simulator": "node --loader ts-node/esm scripts/simulator.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.25.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
